---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ldJson } from '../data/seo';

interface Props {
  title: string;
  description: string;
  /** Path used for the canonical URL, for example "/dino". */
  path?: string;
  /** Set on 404 so search engines do not index it. */
  noindex?: boolean;
  bodyClass?: string;
  /** Path of the share picture (1200x630). */
  ogImage?: string;
  /** Alt text for the share picture. */
  ogImageAlt?: string;
  /** JSON-LD objects written as data blocks in the head. */
  jsonLd?: object[];
}

const {
  title,
  description,
  path = '/',
  noindex = false,
  bodyClass,
  ogImage: ogImagePath = '/og.png',
  ogImageAlt = 'Elinsoft wordmark with a pink smiley on a pale pink background',
  jsonLd = [],
} = Astro.props;
const site = Astro.site ?? new URL('https://elinsoft.co.uk');
const canonical = new URL(path, site).toString();
const ogImage = new URL(ogImagePath, site).toString();
const fonts =
  'https://fonts.googleapis.com/css2?family=Fraunces:wght@300;700&family=Inter:wght@400;500;600;800&display=swap';
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FFE8F3" />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical} />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Elinsoft" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    {jsonLd.map((data) => <script type="application/ld+json" is:inline set:html={ldJson(data)} />)}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fonts} />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a class="skip" href="#main">Skip to content</a>
    <slot name="header"><Header /></slot>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
