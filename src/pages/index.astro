---
import Layout from '../layouts/Layout.astro';
import Mark from '../components/Mark.astro';
import DinoMark from '../components/DinoMark.astro';
import Smiley from '../components/Smiley.astro';
import StoreButtons from '../components/StoreButtons.astro';
import { Picture } from 'astro:assets';
import { bookCovers, rtstIconArt } from '../data/assets';

const platforms = ['iPhone & iPad', 'Android', 'Windows', 'Sonos'];
---

<Layout
  title="Elinsoft: apps and stories for families"
  description="Elinsoft is a small London studio making bedtime story apps, reading tools and children's books."
  path="/"
>
  <div class="container hero-wrap">
    <section class="hero panel" aria-labelledby="hero-title">
      <span class="hero__dot hero__dot--lilac" aria-hidden="true"></span>
      <span class="hero__dot hero__dot--sun" aria-hidden="true"></span>
      <span class="hero__dot hero__dot--aqua" aria-hidden="true"></span>
      <span class="hero__dot hero__dot--pink" aria-hidden="true"></span>

      <div class="hero__text">
        <h1 id="hero-title">
          Apps and stories <span class="hero__accent">for families</span><span class="stop">.</span>
        </h1>
        <p class="hero__lead">
          Elinsoft is a small London studio making bedtime story apps, reading tools and children's books.
        </p>
        <div class="hero__actions">
          <a class="btn btn--primary" href="/dino">Meet Dino</a>
          <a class="btn btn--ghost" href="#apps">All our apps</a>
        </div>
      </div>
      <div class="hero__mark">
        <Mark size={320} />
      </div>
    </section>
  </div>

  <section class="section" id="apps" aria-labelledby="apps-title">
    <div class="container">
      <h2 class="section__title" id="apps-title">Our apps<span class="stop">.</span></h2>
      <div class="cards">
        <article class="card card--lilac card--link">
          <DinoMark size={56} />
          <h3 class="card__title">
            <a class="card__link" href="/dino">Dino: Kids Books &amp; Stories</a>
          </h3>
          <p>Bedtime tales in your voice. Picture books read aloud, with recordings from your own family.</p>
          <ul class="chips" aria-label="Platforms">
            {platforms.map((p, i) => <li>{p}{i < platforms.length - 1 && <span class="chips__sep" aria-hidden="true"> &middot;</span>}</li>)}
          </ul>
        </article>

        <article class="card card--aqua">
          <span class="card__icon">
            <Picture
              src={rtstIconArt.src}
              alt=""
              width={56}
              height={56}
              widths={[56, 112, 192]}
              sizes="56px"
              formats={['avif', 'webp']}
              fallbackFormat="png"
              loading="lazy"
              decoding="async"
            />
          </span>
          <h3 class="card__title">Read The Stupid Text</h3>
          <p>Reads any text out loud — on screen, or from a photo. Natural voices that work fully offline.</p>
          <StoreButtons app="rtst" tone="dark" />
        </article>
      </div>
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="teaser-title">
    <div class="container">
      <div class="teaser panel on-dark">
        <div class="teaser__text">
          <p class="eyebrow teaser__eyebrow">Featured app</p>
          <h2 id="teaser-title" class="teaser__title">Dino: Kids Books &amp; Stories</h2>
          <p class="teaser__sub">Bedtime Tales in Your Voice</p>
          <StoreButtons app="dino" tone="light" />
          <p class="teaser__action">
            <a class="btn btn--sun" href="/dino">See how Dino works &rarr;</a>
          </p>
          <p class="teaser__note">Also plays on Sonos speakers. Alexa coming soon.</p>
        </div>
        <div class="teaser__art" aria-hidden="true">
          <DinoMark size={200} />
          <span class="teaser__moon"></span>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="books" aria-labelledby="books-title">
    <div class="container">
      <h2 class="section__title" id="books-title">Our books<span class="stop">.</span></h2>
      <p class="section__lead">Little Seagull's Big Adventures — picture books for little readers.</p>
      <ul class="covers">
        {
          bookCovers.map((book) => (
            <li class={`cover cover--${book.tint}`}>
              <Picture
                src={book.src}
                alt={book.alt}
                widths={[200, 400, 600]}
                sizes="(min-width: 1160px) 360px, (min-width: 640px) 33vw, 50vw"
                formats={['avif', 'webp']}
                fallbackFormat="jpg"
                loading="lazy"
                decoding="async"
              />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--tight" id="about" aria-labelledby="about-title">
    <div class="container">
      <div class="about panel">
        <Smiley class="about__smiley" />
        <div class="about__text">
          <h2 id="about-title" class="section__title">About<span class="stop">.</span></h2>
          <p>
            Elinsoft — short for Elin Software — was founded in London in 2026 by Ashkan Sirous, a software engineer
            with 17 years' experience. We build software and stories for families, starting with the ones we use at
            home.
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero-wrap {
    padding-top: 8px;
  }

  .hero {
    position: relative;
    display: grid;
    gap: 24px;
    align-items: center;
    overflow: hidden;
    background: var(--blush);
    padding-block: 44px 36px;
  }

  @media (min-width: 860px) {
    .hero {
      grid-template-columns: 1.15fr 0.85fr;
      padding-block: 88px;
    }
  }

  .hero__dot {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
  }

  .hero__dot--lilac {
    width: 260px;
    height: 260px;
    right: -70px;
    top: -80px;
    background: var(--lilac);
  }

  .hero__dot--sun {
    width: 56px;
    height: 56px;
    right: 24px;
    top: 22px;
    background: var(--sun);
    opacity: 0.9;
  }

  .hero__dot--aqua {
    width: 150px;
    height: 150px;
    left: -50px;
    bottom: -60px;
    background: var(--aqua);
  }

  .hero__dot--pink {
    width: 22px;
    height: 22px;
    right: 38%;
    top: 36px;
    background: var(--pink);
    opacity: 0.8;
  }

  .hero__text,
  .hero__mark {
    position: relative;
  }

  .hero h1 {
    font-size: clamp(2.6rem, 9vw, 4.75rem);
    line-height: 1.02;
  }

  .hero__accent {
    color: var(--purple);
  }

  .hero__lead {
    max-width: 32rem;
    margin-top: 20px;
    font-size: 1.1875rem;
    color: var(--ink-soft);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  /* On phones the mark sits in the corner, out of the text flow, so the web-font swap cannot push it around. */
  .hero__mark {
    position: absolute;
    right: -14px;
    bottom: -18px;
    display: flex;
    justify-content: center;
  }

  @media (min-width: 860px) {
    .hero__mark {
      position: relative;
      right: auto;
      bottom: auto;
    }
  }

  .hero__mark :global(svg) {
    width: 150px;
    height: auto;
  }

  @media (min-width: 860px) {
    .hero__mark :global(svg) {
      width: min(30vw, 340px);
    }
  }

  .hero__mark :global(svg) {
    height: auto;
    filter: drop-shadow(0 22px 24px rgba(123, 77, 255, 0.28));
    transform: rotate(4deg);
  }

  /* Cards */

  .cards {
    display: grid;
    gap: 20px;
    margin-top: 28px;
  }

  @media (min-width: 768px) {
    .cards {
      grid-template-columns: 1fr 1fr;
      gap: 28px;
    }
  }

  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    padding: 28px 24px 32px;
    border-radius: var(--radius-card);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  @media (min-width: 640px) {
    .card {
      padding: 36px 36px 40px;
    }
  }

  .card--lilac {
    background: var(--lilac);
  }

  .card--aqua {
    background: var(--aqua);
  }

  .card--link:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-soft);
  }

  .card__title {
    font-size: 1.75rem;
  }

  .card p {
    color: var(--ink-soft);
    font-size: 1.0625rem;
  }

  .card__link {
    text-decoration: none;
  }

  /* The whole card is the link target. */
  .card__link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-card);
  }

  .card__link:focus-visible {
    outline: none;
  }

  .card__link:focus-visible::after {
    outline: 3px solid var(--ink);
    outline-offset: 3px;
  }

  .card :global(.stores) {
    margin-top: auto;
    padding-top: 6px;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 6px;
    margin-top: auto;
    padding-top: 6px;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--purple-text);
  }

  /* Dino teaser */

  .section--tight {
    padding-block: 28px;
  }

  .teaser {
    position: relative;
    display: grid;
    gap: 28px;
    align-items: center;
    overflow: hidden;
    background: var(--purple);
    color: #fff;
  }

  @media (min-width: 860px) {
    .teaser {
      grid-template-columns: 1.4fr 0.6fr;
    }
  }

  .teaser__eyebrow {
    display: inline-block;
    padding: 6px 14px;
    border: 1.5px solid rgba(255, 255, 255, 0.7);
    border-radius: 999px;
  }

  .teaser__title {
    margin-top: 16px;
    font-size: clamp(2rem, 6vw, 3.25rem);
  }

  .teaser__sub {
    margin: 8px 0 24px;
    font-family: var(--font-heading);
    font-size: 1.375rem;
    font-weight: 300;
  }

  .teaser__action {
    margin-top: 22px;
  }

  .teaser__note {
    margin-top: 18px;
    font-size: 0.9375rem;
  }

  .teaser__art {
    position: relative;
    display: none;
    justify-content: center;
  }

  @media (min-width: 860px) {
    .teaser__art {
      display: flex;
    }
  }

  .teaser__art :global(.dino-mark) {
    transform: rotate(-8deg);
    filter: drop-shadow(0 20px 26px rgba(20, 22, 27, 0.35));
  }

  .teaser__art :global(.dino-mark img) {
    border-radius: 48px;
    box-shadow: 0 0 0 6px #fff;
  }

  .teaser__moon {
    position: absolute;
    top: -30px;
    right: 6px;
    width: 54px;
    height: 54px;
    border-radius: 50%;
    background: var(--sun);
    box-shadow: 0 0 0 14px rgba(255, 194, 46, 0.2);
  }

  /* Books */

  .covers {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 150px), 1fr));
    gap: 14px;
    margin-top: 28px;
  }

  .cover {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    padding: 16px;
    border-radius: var(--radius-card);
    text-align: center;
    overflow: hidden;
  }

  .cover :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* The whole cover shows on the tinted tile, so no title is cut. */
  .cover :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 6px;
  }

  .card__icon {
    display: inline-flex;
  }

  .card__icon :global(img) {
    display: block;
    width: 56px;
    height: 56px;
    border-radius: 14px;
  }

  .cover--cream {
    background: var(--cream);
  }

  .cover--aqua {
    background: var(--aqua);
  }

  .cover--lilac {
    background: var(--lilac);
  }

  .cover--blush {
    background: var(--blush);
  }

  .cover__title {
    font-family: var(--font-heading);
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    max-width: 11ch;
  }

  /* About */

  .about {
    display: grid;
    gap: 24px;
    align-items: center;
    background: var(--cream);
  }

  @media (min-width: 768px) {
    .about {
      grid-template-columns: auto 1fr;
      gap: 56px;
    }
  }

  .about :global(.about__smiley) {
    width: 120px;
    height: 120px;
    transform: rotate(-8deg);
  }

  @media (min-width: 768px) {
    .about :global(.about__smiley) {
      width: 220px;
      height: 220px;
    }
  }

  .about p {
    max-width: 40rem;
    font-size: 1.1875rem;
    color: var(--ink-soft);
  }

  @media (prefers-reduced-motion: reduce) {
    .card {
      transition: none;
    }

    .card--link:hover {
      transform: none;
    }
  }
</style>
