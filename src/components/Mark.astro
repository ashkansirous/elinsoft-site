---
// The Elinsoft mark: purple disc, white Fraunces Bold "E", small sun dot. Spec: viewBox 0 0 64 64, group rotated -10deg.
interface Props {
  size?: number;
  /** Accessible name. Leave out when the mark sits next to text that already says "Elinsoft". */
  title?: string;
  class?: string;
}
const { size = 64, title, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 64 64"
  role={title ? 'img' : undefined}
  aria-label={title}
  aria-hidden={title ? undefined : 'true'}
  focusable="false"
>
  <g transform="rotate(-10 32 32)">
    <circle cx="32" cy="32" r="29" fill="#7B4DFF"></circle>
    <text x="28" y="44" text-anchor="middle" font-family="Fraunces, Georgia, serif" font-weight="700" font-size="34" fill="#fff">E</text>
    <circle cx="47" cy="40" r="4.5" fill="#FFC22E"></circle>
  </g>
</svg>
