---
// The small drawn smiley: pink circle, two white eyes, white smile. Decorative.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg class={className} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  <circle cx="16" cy="16" r="16" fill="#FF4FA3"></circle>
  <circle cx="11.2" cy="13.2" r="2.5" fill="#fff"></circle>
  <circle cx="20.8" cy="13.2" r="2.5" fill="#fff"></circle>
  <path d="M9.6 19.2Q16 25.8 22.4 19.2" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round"></path>
</svg>
