---
// The real Dino app icon (src/assets/dino-icon.png, from the ReadTheStupidText repo). `size` is the display width in CSS
// pixels; the sources are 2x and 1x of it, capped at the 512 px file. Decorative (alt="") unless `alt` is given.
import { Picture } from 'astro:assets';
import { dinoIconArt } from '../data/assets';

interface Props {
  size?: number;
  class?: string;
  /** Describes the icon where it is not next to the app name; empty (decorative) by default. */
  alt?: string;
  /** Only the first-screen picture of a page loads eagerly. */
  eager?: boolean;
  /** The largest first-screen picture: asks the browser to fetch it first. */
  priority?: boolean;
  /** Override when CSS makes the icon larger or smaller than `size` (for example by breakpoint). */
  sizes?: string;
}
const { size = 40, class: className, alt = '', eager = false, priority = false, sizes } = Astro.props;
const widths = [...new Set([size, size * 2, 512].filter((w) => w <= 512))].sort((a, b) => a - b);
---

<span class:list={['dino-mark', className]}>
  <Picture
    src={dinoIconArt.src}
    alt={alt}
    width={size}
    height={size}
    widths={widths}
    sizes={sizes ?? `${size}px`}
    formats={['avif', 'webp']}
    fallbackFormat="png"
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
    fetchpriority={priority ? 'high' : undefined}
  />
</span>

<style>
  .dino-mark {
    display: inline-flex;
    flex: none;
  }

  .dino-mark :global(img) {
    display: block;
    border-radius: 22.5%;
  }
</style>
