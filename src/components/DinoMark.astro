---
// App mark for Dino (the brief does not supply one): purple tile with the pink smiley.
interface Props {
  size?: number;
  class?: string;
}
const { size = 40, class: className } = Astro.props;
---

<span class:list={['dino-mark', className]} aria-hidden="true">
  <svg width={size} height={size} viewBox="0 0 64 64" focusable="false">
    <rect width="64" height="64" rx="16" fill="#7B4DFF"></rect>
    <path d="M14 19c8-3 14-1 18 3 4-4 10-6 18-3v26c-8-3-14-1-18 3-4-4-10-6-18-3z" fill="#fff"></path>
    <path d="M32 22v26" stroke="#7B4DFF" stroke-width="2.4"></path>
    <circle cx="41" cy="33" r="7.5" fill="#FF4FA3"></circle>
    <circle cx="38.6" cy="31.6" r="1.2" fill="#fff"></circle>
    <circle cx="43.4" cy="31.6" r="1.2" fill="#fff"></circle>
    <path d="M38 35Q41 38.2 44 35" fill="none" stroke="#fff" stroke-width="1.3" stroke-linecap="round"></path>
  </svg>
</span>

<style>
  .dino-mark {
    display: inline-flex;
    flex: none;
  }
</style>
