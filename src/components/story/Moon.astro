---
// Glowing yellow moon with a few stars. Decorative.
---

<div class="moon" aria-hidden="true">
  <span class="moon__star moon__star--1"></span>
  <span class="moon__star moon__star--2"></span>
  <span class="moon__star moon__star--3"></span>
  <span class="moon__star moon__star--4"></span>
  <span class="moon__disc">
    <span class="moon__crater moon__crater--1"></span>
    <span class="moon__crater moon__crater--2"></span>
    <span class="moon__crater moon__crater--3"></span>
  </span>
</div>
