    <svg viewBox="0 0 60 112" focusable="false" aria-hidden="true">
      <rect x="2" y="2" width="56" height="108" rx="12" fill="#fff" stroke="#14161B" stroke-width="3"></rect>
      <rect x="22" y="8" width="16" height="5" rx="2.5" fill="#14161B"></rect>
      <circle cx="30" cy="36" r="9" fill="#FF4FA3"></circle>
      <rect x="12" y="56" width="36" height="5" rx="2.5" fill="#E1F6FA"></rect>
      <rect x="12" y="66" width="26" height="5" rx="2.5" fill="#E1F6FA"></rect>
    </svg>
    <span class="device__label">iPhone</span>
  </li>
  <li class="device device--1">
    <svg viewBox="0 0 96 128" focusable="false" aria-hidden="true">
      <rect x="2" y="2" width="92" height="124" rx="10" fill="#fff" stroke="#14161B" stroke-width="3"></rect>
      <circle cx="48" cy="48" r="16" fill="#7B4DFF"></circle>
